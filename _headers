# Response headers for every page and file (Cloudflare Workers static assets read this file;
# it is not served as a page).

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Images and the hero videos: let browsers reuse them for a week instead of re-checking on every visit.
/images/*
  Cache-Control: public, max-age=604800

# Declare UTF-8 on every page, so crawlers and AI tools that ignore <meta charset> still read
# characters like "—" and "SF₆" correctly. Pages are listed one by one because a catch-all rule
# would also relabel images, videos and robots.txt. Add new pages here.
/
  Content-Type: text/html; charset=utf-8
/about
  Content-Type: text/html; charset=utf-8
/products
  Content-Type: text/html; charset=utf-8
